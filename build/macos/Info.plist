<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template for Lumio.app. build/macos/make-app.sh fills in the version. -->
<plist version="1.0">
<dict>
  <key>CFBundleName</key>
  <string>Lumio</string>
  <key>CFBundleDisplayName</key>
  <string>Lumio</string>
  <key>CFBundleIdentifier</key>
  <string>app.lumio.desktop</string>
  <key>CFBundleExecutable</key>
  <string>Lumio.Desktop</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>{{VERSION}}</string>
  <key>CFBundleVersion</key>
  <string>{{VERSION}}</string>
  <!-- macOS 26+: icon from Assets.car (compiled from assets/icons/Lumio.icon) -->
  <key>CFBundleIconName</key>
  <string>Lumio</string>
  <!-- macOS 11-15: legacy icon -->
  <key>CFBundleIconFile</key>
  <string>Lumio</string>
  <key>LSMinimumSystemVersion</key>
  <string>12.0</string>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.developer-tools</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSPrincipalClass</key>
  <string>NSApplication</string>
</dict>
</plist>
