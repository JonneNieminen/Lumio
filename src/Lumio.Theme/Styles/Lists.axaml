<!-- List styles: nav (drawer), tiles (choosable cards), rows (history tables). -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- Drawer navigation -->
  <Style Selector="ListBox.nav ListBoxItem">
    <Setter Property="CornerRadius" Value="{StaticResource LmRadiusMd}" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="Margin" Value="0,0,0,2" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Foreground" Value="{DynamicResource LmTextSecondaryBrush}" />
    <Setter Property="FontWeight" Value="{StaticResource LmFontWeightMedium}" />
    <Style Selector="^ PathIcon">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
    </Style>
    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource LmSurface3Brush}" />
      <Setter Property="Foreground" Value="{DynamicResource LmTextPrimaryBrush}" />
    </Style>
    <Style Selector="^:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource LmAccentSoftBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource LmAccentTextBrush}" />
    </Style>
    <Style Selector="^:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource LmAccentSoftBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource LmAccentTextBrush}" />
    </Style>
  </Style>

  <!-- Choosable cards (provider picker) -->
  <Style Selector="ListBox.tiles ListBoxItem">
    <Setter Property="Padding" Value="16" />
    <Setter Property="Margin" Value="0,0,12,12" />
    <Setter Property="CornerRadius" Value="{StaticResource LmRadiusLg}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource LmBorderBrush}" />
    <Setter Property="Background" Value="{DynamicResource LmSurface1Brush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource LmBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource LmRadiusLg}" />
    </Style>
    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource LmSurface1Brush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LmBorderStrongBrush}" />
    </Style>
    <Style Selector="^:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource LmAccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LmAccentTextBrush}" />
    </Style>
    <Style Selector="^:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource LmAccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LmAccentTextBrush}" />
    </Style>
  </Style>
</Styles>
